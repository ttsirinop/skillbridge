          "id",
          "full_name",
          "email",
          "department",
          "skills",
          "summary",
          "model_version",
          "created_at"
        ],
        "title": "Profile",
        "type": "object"
      },
      "ProfileCreate": {
        "additionalProperties": false,
        "properties": {
          "department": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "Engineering"
            ],
            "title": "Department"
          },
          "email": {
            "examples": [
              "avery.brooks@example.com"
            ],
            "maxLength": 254,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "examples": [
              "Avery Brooks"
            ],
            "maxLength": 200,
            "minLength": 1,
            "title": "Full Name",
            "type": "string"
          },
          "skills": {
            "examples": [
              [
                "Python",
                "FastAPI",
                "PostgreSQL"
              ]
            ],
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Skills",
            "type": "array"
          },
          "summary": {
            "default": "",
            "maxLength": 2000,
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "full_name",
          "email",
          "skills"
        ],
        "title": "ProfileCreate",
        "type": "object"
      },
