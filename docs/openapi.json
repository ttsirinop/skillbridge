        "title": "Role",
        "type": "object"
      },
      "RoleCreate": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "default": "",
            "maxLength": 2000,
            "title": "Description",
            "type": "string"
          },
          "required_skills": {
            "examples": [
              [
                "Python",
                "FastAPI",
                "PostgreSQL"
              ]
